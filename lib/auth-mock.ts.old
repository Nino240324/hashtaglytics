  // eslint-disable-next-line no-console
  console.log('[stub] requestPasswordReset called with', { email }, '-- no real effect.');
  return { ok: true };
}

export async function resetPassword(newPassword: string): Promise<{ ok: true }> {
  // eslint-disable-next-line no-console
  console.log('[stub] resetPassword called -- no real effect. Length was', newPassword.length);
  return { ok: true };
}

export async function resendVerificationEmail(): Promise<{ ok: true }> {
  return { ok: true };
}

// Demo-only, not part of the real product: simulates clicking the real
// verification link, since no real e-mail is ever sent here. Without
// this there would be no way to reach or test the "verified" side of
// the redirect rules at all.
export function demoMarkVerified() {
  setCookie('mock_verified', '1');
}

export function signOut() {
  clearCookie('mock_session');
  clearCookie('mock_verified');
}
