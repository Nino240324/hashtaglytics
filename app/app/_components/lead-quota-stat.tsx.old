// app/app/_components/lead-quota-stat.tsx
//
// The number an agency cares about most (quota_changes_prompt.md, Change
// 2). No global app header exists -- the top bar is the public site's --
// so this is placed inline on each screen that needs it: beside the
// campaign counter on /app/campagnes, and on the tab row on
// /app/prospects.
//
// No <Tooltip.Provider> here -- assumes the caller supplies one. Both
// current placements already have one from their own existing tooltips.

'use client';

import * as Tooltip from '@radix-ui/react-tooltip';
import type { AgencyPlanUsage } from '@/lib/mock-data';

function formatDateFR(iso: string): string {
  return new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long' }).format(new Date(iso));
}

export function LeadQuotaStat({ planUsage }: { planUsage: AgencyPlanUsage }) {
  const { leads_delivered_this_period, max_leads_per_month, period_end } = planUsage;

  // null = unlimited (enterprise), same convention as maxActiveCampaigns.
  // Not explicitly stated for THIS quota in the brief, but the type
  // comment ("null = unlimited") only makes sense under the same rule --
  // applied by analogy, flagged as such rather than silently assumed.
  if (max_leads_per_month === null) {
    return (
      <span className="lead-quota-stat">
        <span className="mono-num">{leads_delivered_this_period}</span> prospects qualifiés ce
        mois
      </span>
    );
  }

  const pct = (leads_delivered_this_period / max_leads_per_month) * 100;
  const level = pct >= 100 ? 'at-limit' : pct >= 80 ? 'warning' : 'normal';

  return (
    <Tooltip.Root>
      <Tooltip.Trigger asChild>
        <button type="button" className={`lead-quota-stat lead-quota-${level}`}>
          <span className="mono-num">
            {leads_delivered_this_period} / {max_leads_per_month}
          </span>{' '}
          prospects qualifiés ce mois
        </button>
      </Tooltip.Trigger>
      <Tooltip.Portal>
        <Tooltip.Content className="info-tooltip-content" sideOffset={6}>
          Renouvellement le {formatDateFR(period_end)}
          <Tooltip.Arrow className="info-tooltip-arrow" />
        </Tooltip.Content>
      </Tooltip.Portal>
    </Tooltip.Root>
  );
}
