// app/app/_components/bfcache-reload.tsx
//
// Root cause fix, not a prospects-page fix: the browser can restore ANY
// /app/* screen from back/forward cache with HTML captured at an earlier
// moment -- after data loaded, with filters applied, with a row expanded
// -- while React hydrates against fresh initial state. Nothing
// reconciles that automatically. This isn't limited to the pagination
// case that surfaced it: filters, sort, page, search, and expanded-row
// state can all diverge the same way, on any current or future screen.
// One listener here, in the shared /app layout, covers all of them
// rather than requiring each screen to individually guard against it.
//
// Trade-off accepted deliberately: this forfeits bfcache's instant back
// navigation within /app. For a dashboard showing live quota/lead/
// campaign numbers, a stale snapshot is worse than a brief reload. A
// marketing page would decide differently -- this is scoped to the /app
// layout specifically, not the public site.

'use client';

import { useEffect } from 'react';

export function BfcacheReload() {
  useEffect(() => {
    const onPageShow = (e: PageTransitionEvent) => {
      // event.persisted means this page came from the back/forward cache
      // rather than a fresh load. Force a real load instead of letting
      // React try to reconcile stale HTML against fresh state.
      if (e.persisted) window.location.reload();
    };
    window.addEventListener('pageshow', onPageShow);
    return () => window.removeEventListener('pageshow', onPageShow);
  }, []);

  return null;
}
